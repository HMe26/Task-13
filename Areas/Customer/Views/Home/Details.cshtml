@model MovieWithRelatedVM

@{
    ViewData["Title"] = Model.Movie.Name;
}

<div class="row g-4">
    <div class="col-lg-5">
        <img class="img-fluid rounded-2 w-100" style="height:460px;object-fit:cover;" src="/imgs/movies/@Model.Movie.MainImg" alt="@Model.Movie.Name" />

        @if (Model.Movie.SubImages.Any())
        {
            <div class="row g-2 mt-1">
                @foreach (var sub in Model.Movie.SubImages)
                {
                    <div class="col-3">
                        <img class="img-fluid rounded-1 border border-200" style="height:70px;object-fit:cover;width:100%;" src="/imgs/movies/sub-imgs/@sub.SubImg" alt="@Model.Movie.Name" />
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-primary-subtle text-primary">@Model.Movie.Category?.Name</span>
            <span class="badge bg-200 text-800">@Model.Movie.Cinema?.Name</span>
        </div>

        <h2 class="mb-3">@Model.Movie.Name</h2>

        <p class="text-muted mb-4">@Model.Movie.Des</p>

        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <div class="card h-100">
                    <div class="card-body">
                        <p class="fs-10 text-muted mb-1">Showtime</p>
                        <p class="mb-0 fw-semi-bold">@Model.Movie.DateTime.ToString("yyyy-MM-dd hh:mm tt")</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="card h-100">
                    <div class="card-body">
                        <p class="fs-10 text-muted mb-1">Price</p>
                        <p class="mb-0 fw-semi-bold">@Model.Movie.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</p>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Actors.Any())
        {
            <h6 class="mb-3">Cast</h6>
            <div class="row g-3 mb-4">
                @foreach (var actor in Model.Actors)
                {
                    <div class="col-4 col-sm-3 col-md-2">
                        <div class="text-center">
                            <img class="rounded-circle border border-200 mb-2" style="width:64px;height:64px;object-fit:cover;" src="/imgs/actors/@actor.Img" alt="@actor.Name" />
                            <p class="fs-10 mb-0 text-truncate">@actor.Name</p>
                        </div>
                    </div>
                }
            </div>
        }

        <button type="button" class="btn btn-primary btn-lg disabled" disabled>
            <span class="fas fa-ticket-alt me-2"></span>Booking coming soon
        </button>
    </div>
</div>

@if (Model.RelatedMovies.Any())
{
    <hr class="my-5" />

    <h5 class="mb-3">You may also like</h5>
    <div class="row g-3">
        @foreach (var movie in Model.RelatedMovies)
        {
            <div class="col-md-6 col-lg-3">
                <a href="/Customer/Home/Details/@movie.Id" class="text-decoration-none">
                    <div class="card h-100">
                        <img class="card-img-top" src="/imgs/movies/@movie.MainImg" style="height:220px;object-fit:cover;" alt="@movie.Name" />
                        <div class="card-body">
                            <h6 class="mb-1 text-body">@movie.Name</h6>
                            <p class="fs-10 text-muted mb-1">@movie.Category?.Name</p>
                            <span class="badge text-bg-primary">@movie.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
